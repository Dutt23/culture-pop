# Copy this file to .env (git-ignored) and fill in your own values. `vercel dev` reads only .env, not .env.local. Never commit real values.
# On a linked project, `npx vercel@65.9.0 env pull .env` writes .env from Vercel's Development values.
# Full steps: docs/BACKEND_PLAN.md, "Run it locally".

# Parallel Search API key (parallel.ai). Not needed when WEB_SEARCH_FAKE=1.
PARALLEL_API_KEY=

# Local testing only: 1 = canned results, no key, nothing spent. Honoured only under `vercel dev`.
# Searches still need a signed-in account with wider web search turned on (SUPABASE_* below).
WEB_SEARCH_FAKE=1

# Local testing only: 1 = sign-in cookie without `Secure`, for a phone on plain http over Wi-Fi.
# Honoured only under `vercel dev`. Leave empty when testing on this computer (localhost).
ACCESS_COOKIE_INSECURE_DEV=

# OpenAI API key for AI card drafts. Not needed when CARD_DRAFT_FAKE=1.
OPENAI_API_KEY=

# Optional: OpenAI model id for card drafts. Empty = gpt-6-luna.
OPENAI_MODEL=

# Cloudflare account ID, used for AI card drafts. Not needed when CARD_DRAFT_FAKE=1.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token, used for AI card drafts. Not needed when CARD_DRAFT_FAKE=1.
CLOUDFLARE_API_TOKEN=

# Optional: Workers AI model id for card drafts. Empty = @cf/meta/llama-3.3-70b-instruct-fp8-fast.
CLOUDFLARE_MODEL=

# Local testing only: 1 = canned card drafts, no keys, nothing spent. Honoured only under `vercel dev`.
CARD_DRAFT_FAKE=

# Supabase (D64, docs/SUPABASE_SETUP.md). Server only: never prefix with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# The app's own address, no trailing slash. Sign-in stays off without it.
APP_ORIGIN=http://localhost:3000

# Live sign-in end-to-end test only (npm run test:e2e:live): a test user made by hand in Supabase.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
