# Copy this file to .env (git-ignored) and fill in your own values. `vercel dev` reads only .env, not .env.local. Never commit real values.
# On a linked project, `npx vercel@65.9.0 env pull .env` writes .env from Vercel's Development values.
# Full steps: docs/BACKEND_PLAN.md, "Run it locally".

# Access code friends type to unlock the wider-web search. At least 12 characters (shorter → 503).
ACCESS_CODE=

# Signs the access cookie. At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_COOKIE_SECRET=

# Parallel Search API key (parallel.ai). Not needed when WEB_SEARCH_FAKE=1.
PARALLEL_API_KEY=

# Local testing only: 1 = canned results, no key, nothing spent. Ignored on Vercel deployments.
WEB_SEARCH_FAKE=1

# Local testing only: 1 = access cookie without `Secure`, for a phone on plain http over Wi-Fi.
# Ignored on Vercel deployments. Leave empty when testing on this computer (localhost).
ACCESS_COOKIE_INSECURE_DEV=

# OpenAI API key for AI card drafts. Not needed when CARD_DRAFT_FAKE=1.
OPENAI_API_KEY=

# Cloudflare account ID, used for AI card drafts. Not needed when CARD_DRAFT_FAKE=1.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token, used for AI card drafts. Not needed when CARD_DRAFT_FAKE=1.
CLOUDFLARE_API_TOKEN=

# Local testing only: 1 = canned card drafts, no keys, nothing spent. Ignored on Vercel deployments.
CARD_DRAFT_FAKE=
